&CONTROL
  calculation = 'vc-relax'
  restart_mode = 'from_scratch'
  prefix = 'Pt-Pd-Rh-12_Pd2Pt2Rh2_unified_pd04'
  pseudo_dir = './pseudo'
  outdir = './scratch'
  tprnfor = .true.
  tstress = .true.
  disk_io = 'low'
  nstep = 120
  max_seconds = 36000
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-5
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 3
  ecutwfc = 110.0
  ecutrho = 440.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-8
  electron_maxstep = 200
  mixing_beta = 0.3
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = 'all'
  press = 0.0
  press_conv_thr = 0.5
/
