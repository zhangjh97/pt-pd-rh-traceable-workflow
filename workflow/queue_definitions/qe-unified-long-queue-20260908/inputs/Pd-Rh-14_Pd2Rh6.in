&CONTROL
  calculation = 'vc-relax'
  restart_mode = 'from_scratch'
  prefix = 'Pd-Rh-14_Pd2Rh6_unified_pd04'
  pseudo_dir = './pseudo'
  outdir = './scratch'
  tprnfor = .true.
  tstress = .true.
  disk_io = 'low'
  nstep = 120
  max_seconds = 36000
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-5
/
&SYSTEM
  ibrav = 0
  nat = 8
  ntyp = 2
  ecutwfc = 110.0
