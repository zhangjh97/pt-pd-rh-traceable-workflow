  electron_maxstep = 200
  mixing_beta = 0.3
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = 'all'
  press = 0.0
  press_conv_thr = 0.5
/
